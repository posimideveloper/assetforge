{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@stellar/stellar-sdk": [
        "./node_modules/@stellar/stellar-sdk"
      ]
    }
  },
  "include": [
    "src",
    "../src/config.ts",
    "../src/plan.ts",
    "../src/toml.ts",
    "../src/audit.ts"
  ],
  "exclude": [
    "dist"
  ]
}